<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ketu_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <Button
            android:id="@+id/btnLegalBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="←"
            android:textAllCaps="false"
            android:textSize="22sp"
            android:contentDescription="Back" />

        <TextView android:text="About &amp; Privacy" android:textSize="28sp" android:textStyle="bold"
            android:textColor="@color/ketu_ink" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <TextView android:text="About Ketu" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/ketu_ink" android:layout_marginTop="28dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="@string/about_body" android:textColor="@color/ketu_muted" android:textSize="15sp"
            android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="Privacy Policy" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/ketu_ink" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="@string/privacy_body" android:textColor="@color/ketu_muted" android:textSize="14sp"
            android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="Terms of Service" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/ketu_ink" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="@string/terms_body" android:textColor="@color/ketu_muted" android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>